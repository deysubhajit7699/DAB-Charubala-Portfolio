{
  "name": "charubala-mern",
  "private": true,
  "version": "1.0.0",
  "description": "Charubala LLC agency site — MERN stack (MongoDB, Express, React, Node)",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "start": "npm run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "seed:fresh": "npm --prefix server run seed:fresh",
    "server": "npm --prefix server start",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
