# Copy this file to server/.env and fill in real values.

# Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/charubala
# MongoDB Atlas (free tier is fine):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/charubala?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/charubala

PORT=5000
NODE_ENV=development

# Comma-separated list of frontends allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# Required for every write route (POST/PUT/DELETE) and for reading leads.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=change-me-to-a-long-random-string

# Set to true to have Express also serve client/dist (single-deployment mode).
SERVE_CLIENT=false
